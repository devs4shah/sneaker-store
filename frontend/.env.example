# ===================================================================
# ProSneaker frontend - public environment variables
#
# Only NEXT_PUBLIC_* vars are exposed to the browser. Set these in your
# hosting provider (Vercel/Netlify/etc.) or a local .env.local file.
# ===================================================================

# Base URL of the deployed backend (no trailing slash)
# Local:      http://localhost:8080
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Razorpay public key id (must match the backend RAZORPAY_KEY; secret stays on backend only)
# Local test:  rzp_test_xxxxxxxxxxxxx
# Production:  rzp_live_xxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_your_key_id
