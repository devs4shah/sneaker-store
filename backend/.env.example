# ===================================================================
# ProSneaker backend - environment variables
#
# Copy to a real secrets store (or .env for local docker) and fill in.
# In production set SPRING_PROFILES_ACTIVE=prod so the app fails fast
# when any required secret is missing.
# ===================================================================

# Profile & server
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Database (PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://<db-host>:5432/sneaker_store
DATABASE_USERNAME=prosneaker
DATABASE_PASSWORD=change-me
JPA_DDL_AUTO=update
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- JWT ---
# Use a random 256-bit (32+ char) secret, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Razorpay ---
RAZORPAY_KEY=rzp_live_xxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_CURRENCY=INR

# --- Mail (Brevo SMTP) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=xxxxxxxx@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxx
MAIL_FROM=noreply@your-domain.com

# --- CORS: deployed frontend origin(s), comma separated ---
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# --- Storage / logging (optional) ---
STORAGE_UPLOAD_DIR=/var/lib/prosneaker/uploads
LOG_FILE=/var/log/prosneaker/backend.log
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
ACTUATOR_ENDPOINTS=health,info
ACTUATOR_HEALTH_DETAILS=never
